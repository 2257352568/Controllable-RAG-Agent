# Alibaba Cloud Model Studio OpenAI-compatible endpoint.
# Copy this file to .env and fill only the local copy; never commit a real key.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1536

# Minimal Agent controls used by the learning demo.
AGENT_MAX_STEPS=8
AGENT_MAX_MODEL_REQUESTS=40
AGENT_MAX_TOTAL_TOKENS=20000
AGENT_MAX_ELAPSED_SECONDS=120
RAG_ENABLED_SOURCES=chunks,summaries,quotes
RAG_MIN_EVIDENCE_RECORDS=1
